{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "trusted-signing-cli",
        "args": [
          "-e",
          "https://weu.codesigning.azure.net/",
          "-a",
          "REPLACE_WITH_TRUSTED_SIGNING_ACCOUNT",
          "-c",
          "REPLACE_WITH_CERTIFICATE_PROFILE",
          "%1"
        ]
      }
    }
  }
}
