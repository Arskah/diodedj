{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload.ts",
    "src/types.ts",
    "electron.vite.config.ts",
    "eslint.config.mjs",
    "vitest.config.ts",
    "playwright.config.ts",
    "commitlint.config.ts"
  ]
}
