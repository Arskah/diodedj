{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload.ts",
    "src/types.ts",
    "tests/main/**/*",
    "e2e/",
    "commitlint.config.ts",
    "electron.vite.config.ts",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "svelte.config.mjs",
    "vitest.config.ts"
  ]
}
