{
  "name": "diodedj",
  "version": "0.2.1",
  "description": "Radio station music player",
  "main": "dist/main/main.js",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "electron .",
    "dev": "pnpm build && concurrently -k -n tsc,assets,app \"tsc -w --preserveWatchOutput\" \"node scripts/watch-assets.mjs\" \"electronmon .\"",
    "test": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "electron-rebuild",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "ffmpeg-static": "5.3.0",
    "fluent-ffmpeg": "2.1.3",
    "kysely": "0.28.16",
    "music-metadata": "11.12.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@electron/rebuild": "4.0.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@types/better-sqlite3": "7.6.13",
    "concurrently": "9.2.1",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "electronmon": "2.0.4",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "build": {
    "appId": "com.diodedj.app",
    "productName": "DiodeDJ",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "DiodeDJ scans audio files on your Desktop.",
        "NSDocumentsFolderUsageDescription": "DiodeDJ scans audio files in Documents.",
        "NSDownloadsFolderUsageDescription": "DiodeDJ scans audio files in Downloads.",
        "NSMusicLibraryUsageDescription": "DiodeDJ scans your music library.",
        "NSRemovableVolumesUsageDescription": "DiodeDJ scans audio on external drives.",
        "NSNetworkVolumesUsageDescription": "DiodeDJ scans audio on network volumes."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
