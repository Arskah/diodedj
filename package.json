{
  "name": "diodedj",
  "version": "0.9.1",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node && pnpm typecheck:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --build --rm e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-log": "2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tauri-apps/cli": "2.11.1",
    "@types/mocha": "10.0.10",
    "@types/node": "25.6.2",
    "@vitest/coverage-v8": "4.1.6",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/types": "9.27.1",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.2",
    "svelte": "5.55.7",
    "svelte-check": "4.4.8",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.12",
    "vitest": "4.1.6",
    "webdriverio": "9.27.1"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
