{
  "name": "diodedj",
  "version": "0.11.0",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node && pnpm typecheck:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --build --rm e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-log": "2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/types": "9.29.1",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.6",
    "svelte-check": "4.7.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "webdriverio": "9.29.1"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
