{
  "name": "diodedj",
  "version": "0.1.0",
  "description": "Radio station music player",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/renderer && cp src/renderer/index.html src/renderer/styles.css dist/renderer/",
    "start": "electron .",
    "dev": "pnpm build && concurrently -k -n tsc,assets,app \"tsc -w --preserveWatchOutput\" \"node scripts/watch-assets.mjs\" \"electronmon .\"",
    "test": "vitest",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "electron-rebuild"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "fluent-ffmpeg": "2.1.3",
    "music-metadata": "11.12.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@electron/rebuild": "4.0.4",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "concurrently": "9.2.1",
    "electron": "41.3.0",
    "electronmon": "2.0.4",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
