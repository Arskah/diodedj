{
  "name": "diodedj",
  "version": "0.8.1",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-log": "2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@commitlint/types": "21.0.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tauri-apps/cli": "2.11.0",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.2",
    "svelte": "5.55.5",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.12",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
