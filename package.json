{
  "name": "diodedj",
  "version": "0.10.2",
  "description": "Radio station music player",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node && pnpm typecheck:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "e2e:docker": "docker compose -f docker-compose.e2e.yml run --build --rm e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-log": "2.8.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.4",
    "@vitest/coverage-v8": "4.1.9",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/types": "9.29.1",
    "eslint": "10.6.0",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "17.1.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.5",
    "vitest": "4.1.9",
    "webdriverio": "9.29.1"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578"
}
