{
  "name": "diodedj",
  "version": "0.5.1",
  "description": "Radio station music player",
  "main": "out/main/main.js",
  "author": {
    "name": "Aarni Halinen",
    "email": "diodedj@aarnihalinen.fi"
  },
  "homepage": "https://github.com/Arskah/diodedj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arskah/diodedj.git"
  },
  "bugs": {
    "url": "https://github.com/Arskah/diodedj/issues"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "svelte-check": "svelte-check",
    "typecheck": "pnpm svelte-check && pnpm typecheck:node",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "test": "vitest",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,mts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "better-sqlite3": "12.9.0",
    "electron-log": "5.4.3",
    "electron-window-state": "5.0.3",
    "ffmpeg-static": "5.3.0",
    "kysely": "0.28.16",
    "ms": "2.1.3",
    "music-metadata": "11.12.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "10.2.1",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "svelte": "5.55.5",
    "svelte-check": "4.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
